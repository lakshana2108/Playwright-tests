{
  "name": "ae-myworkspace-playwright-starter",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first QA learning starter for Automation Engine My Workspace",
  "engines": { "node": "^20.19.0 || ^22.13.0 || >=24" },
  "scripts": {
    "setup:browsers": "playwright install chromium",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test:support": "tsx --test support-tests/config.test.ts support-tests/package.test.ts",
    "bdd:gen": "bddgen -c playwright.bdd.config.ts",
    "test:list:native": "playwright test -c playwright.config.ts --list",
    "test:list:bdd": "npm run bdd:gen && playwright test -c playwright.bdd.config.ts --list",
    "test:list": "npm run test:list:native && npm run test:list:bdd",
    "quality": "npm run lint && npm run typecheck && npm run test:support && npm run test:list",
    "setup:check": "tsx scripts/check-setup.ts",
    "auth:capture": "tsx scripts/capture-auth.ts",
    "auth:login": "tsx scripts/capture-auth.ts --credentials",
    "test": "npm run test:native",
    "test:native": "playwright test -c playwright.config.ts",
    "test:bdd": "npm run bdd:gen && playwright test -c playwright.bdd.config.ts",
    "test:smoke": "npm run test:native -- --grep @Smoke",
    "test:headed": "npm run test:native -- --headed",
    "test:workflow": "tsx scripts/run-workflow.ts",
    "test:job-context": "bddgen -c playwright.bdd.config.ts && tsx scripts/run-job-context.ts",
    "test:bdd:activity": "tsx scripts/run-activity.ts",
    "test:debug": "npm run test:native -- --debug",
    "test:ui": "npm run test:native -- --ui",
    "test:bdd:ui": "npm run bdd:gen && playwright test -c playwright.bdd.config.ts --ui",
    "report:native": "playwright show-report artifacts/native/html",
    "report:bdd": "playwright show-report artifacts/bdd/html"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.0.0",
    "dotenv": "^17.2.3",
    "eslint": "10.12.0",
    "playwright-bdd": "9.2.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1"
  }
}
