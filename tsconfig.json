{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["playwright*.ts", "tests/**/*.ts", "scripts/**/*.ts", "support-tests/**/*.ts"],
  "exclude": ["node_modules", ".features-gen", "artifacts", "test-results"]
}
