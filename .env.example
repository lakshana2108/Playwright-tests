# Copy to .env and replace the URL with YOUR approved test environment.
# This placeholder is deliberately rejected by live commands.
BASE_URL=https://your-ae-host.example/myworkspace/

# Separate state for each environment, account and browser.
AUTH_STATE_PATH=.auth/myworkspace-chromium.json

# Fresh-login smoke tests use these only with the verified English local AE form.
# External SSO/MFA needs a separately approved authentication strategy.
LOGIN_USER=YOUR_QA_USER
LOGIN_PASSWORD=YOUR_QA_PASSWORD

# Opt in locally to sensitive failure evidence. Keep false on shared runners.
PW_CAPTURE_EVIDENCE=false
